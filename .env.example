# Google service account (Sheets + Drive read). Two ways to sign in, pick one:
# 1) Keyless on Vercel (Workload Identity Federation with the Vercel OIDC token)
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
# 2) A JSON key, raw or base64 (ignored when the keyless variables are set)
GOOGLE_SERVICE_ACCOUNT_JSON=
# AD BUILDER CLIENTS master sheet, tab CLIENTS (client_id, name, control_sheet_id, drive_root_id, status, added_on, offboarded_on)
MASTER_SHEET_ID=
MASTER_TAB=CLIENTS
# Optional: sheet with CLAUDE SETUP and COMMANDS tabs to copy into new clients. Without it the app builds them itself.
TEMPLATE_SHEET_ID=

# Basic-auth password for the whole app (any username; it is recorded as "by" on commands). Required in production.
APP_PASSWORD=

# Slack bot (chat:write, channels:history). Without it every command goes to the COMMANDS queue.
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_URL=https://withsalt.slack.com
# Claude's Slack user ID, for the @Claude tag
CLAUDE_SLACK_USER_ID=

# Defaults when a client's CLAUDE SETUP is empty
DEFAULT_SKILL=ashtel-studios-ad-builder
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_COMMAND_INTERVAL=60

# Dev only: render against a local JSON fixture instead of Google (ignored in production)
# FAKE_SHEETS_FILE=/path/to/fixture.json
